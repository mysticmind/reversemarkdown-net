<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Benchmarks the published ReverseMarkdown package. Swap the version between runs to compare
         releases (e.g. v5 vs v6): edit this version, or pass -p:RMVersion=5.5.0. -->
    <PackageReference Include="ReverseMarkdown" Version="$(RMVersion)"
                      Condition="'$(UseLocalReverseMarkdown)' != 'true'" />
    <!-- Measure the working tree instead of a published package, which is what you want when
         checking whether a change helped: -p:UseLocalReverseMarkdown=true -->
    <ProjectReference Include="..\ReverseMarkdown\ReverseMarkdown.csproj"
                      SetTargetFramework="TargetFramework=net9.0"
                      Condition="'$(UseLocalReverseMarkdown)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <RMVersion Condition="'$(RMVersion)' == ''">6.0.0</RMVersion>
  </PropertyGroup>

  <!-- BenchmarkDotNet rebuilds this project in a child process that does not inherit -p: switches,
       so without this the benchmarks would silently measure the default package. Program.cs reads
       these back and forwards them to that build. -->
  <ItemGroup>
    <AssemblyMetadata Include="RMVersion" Value="$(RMVersion)" />
    <AssemblyMetadata Include="UseLocalReverseMarkdown" Value="$(UseLocalReverseMarkdown)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Files\1000-paragraphs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Files\10k-paragraphs.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Files\huge.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Corpus fetched by scripts/fetch-benchmark-corpus.sh; gitignored, so the glob may be empty. -->
    <None Include="Files\corpus\*.html" LinkBase="Files\corpus">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>