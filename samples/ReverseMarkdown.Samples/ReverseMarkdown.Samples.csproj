<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the test project can reference it and assert the outputs the
         doc snippets claim. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Documentation samples: methods/locals exist only so the snippets compile against the
         real API. Suppress "unused" and obsolete-usage noise. -->
    <NoWarn>CS0219;CS0168;CS8321;CS0618;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReverseMarkdown\ReverseMarkdown.csproj" />
  </ItemGroup>

</Project>
